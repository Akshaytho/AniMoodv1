# =============================================================================
# AniMood — Master environment template
# Copy to `.env` at repo root and fill in. Never commit `.env`.
# =============================================================================

# --- Railway (personal account token) ---
RAILWAY_API_TOKEN=

# --- Database (Railway Postgres) ---
DATABASE_URL=postgresql://user:pass@host:port/dbname

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL_EXTRACTION=gpt-5.4-mini
OPENAI_MODEL_CHEAP=gpt-5.4-nano
OPENAI_TOKEN_BUDGET=500000

# --- Reddit API (reddit.com/prefs/apps, create 'script' app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AniMoodBot/1.0 by /u/yourusername
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- MyAnimeList (myanimelist.net/apiconfig) ---
MAL_CLIENT_ID=

# --- n8n ---
N8N_BASE_URL=https://animood-n8n.up.railway.app
N8N_API_KEY=

# --- Dashboard ---
DASHBOARD_ADMIN_EMAIL=you@example.com
DASHBOARD_ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Public site ---
NEXT_PUBLIC_SITE_URL=https://animood.app
NEXT_PUBLIC_BASE_DOMAIN=animood.app
REVALIDATE_SECRET=
VERCEL_DEPLOY_HOOK_URL=
